{
  "title": "E-Commerce Streaming Platform",
  "uid": "ecommerce-overview",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["ecommerce", "kafka", "dbt"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Business Metrics (Postgres / dbt)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Orders (selected range)",
      "description": "Count of PURCHASE events within the dashboard's selected time range, computed live from raw.events (not the dbt table, so it's never stale relative to the picker).",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT count(*) AS orders FROM raw.events WHERE event_type = 'PURCHASE' AND $__timeFilter(event_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Revenue (selected range)",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT sum(quantity * unit_price) AS revenue FROM raw.events WHERE event_type = 'PURCHASE' AND $__timeFilter(event_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Units Sold (selected range)",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT sum(quantity) AS units_sold FROM raw.events WHERE event_type = 'PURCHASE' AND $__timeFilter(event_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active Users (selected range)",
      "description": "Distinct user_id in raw.events within the selected time range - not a dbt model, straight from raw since customer_metrics doesn't exist yet.",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT count(DISTINCT user_id) AS active_users FROM raw.events WHERE $__timeFilter(event_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Conversion Rate (view -> purchase, selected range)",
      "description": "PURCHASE events / PRODUCT_VIEW events within the selected time range, from raw.events directly - product_performance's per-product conversion_rate is deferred. This is synthetic demo data with no real purchase funnel, so expect this number to look unrealistically high (event_type_weights in producer/app/config.py treats PURCHASE almost as likely as ADD_TO_CART).",
      "gridPos": { "x": 0, "y": 5, "w": 6, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) FILTER (WHERE event_type = 'PRODUCT_VIEW') = 0 THEN 0 ELSE round(100.0 * count(*) FILTER (WHERE event_type = 'PURCHASE') / count(*) FILTER (WHERE event_type = 'PRODUCT_VIEW'), 2) END AS conversion_rate FROM raw.events WHERE $__timeFilter(event_timestamp)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Event Type Breakdown (selected range)",
      "gridPos": { "x": 6, "y": 5, "w": 9, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT event_type, count(*) AS count FROM raw.events WHERE $__timeFilter(event_timestamp) GROUP BY event_type ORDER BY count DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "xField": "event_type" }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sales Revenue by 15-min Interval (analytics.sales_by_interval)",
      "description": "Refreshed by a cron job running `dbt run` every 15 minutes (scripts/run_dbt.sh) - matches this model's own bucket size, so the trend line is never more than ~15 minutes stale.",
      "gridPos": { "x": 15, "y": 5, "w": 9, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "time_series",
          "rawSql": "SELECT interval_start AS time, revenue FROM analytics.sales_by_interval WHERE $__timeFilter(interval_start) ORDER BY interval_start",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Streaming Metrics (Kafka / kafka-exporter / Prometheus)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Events / sec (ecommerce-events)",
      "description": "rate() of the main topic's per-partition offsets, summed across partitions.",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"ecommerce-events\"}[1m]))",
          "legendFormat": "events/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Consumer Lag",
      "description": "design.md section 19 - how far each consumer group is behind. Should hover near 0 while a consumer is running and traffic is steady.",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "kafka_consumergroup_lag_sum{consumergroup=\"ingestion-service\", topic=\"ecommerce-events\"}",
          "legendFormat": "ingestion-service",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "kafka_consumergroup_lag_sum{consumergroup=\"retry-service\", topic=\"ecommerce-events-retry\"}",
          "legendFormat": "retry-service",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DLQ Message Rate",
      "description": "rate() of ecommerce-events-dlq's offset - how fast rejected/failed events are accumulating (design.md section 12).",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"ecommerce-events-dlq\"}[5m]))",
          "legendFormat": "DLQ msgs/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "DLQ Total Messages",
      "description": "Current offset of ecommerce-events-dlq, summed across partitions - total rejected events ever produced to the DLQ (not net of replays).",
      "gridPos": { "x": 12, "y": 22, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "sum(kafka_topic_partition_current_offset{topic=\"ecommerce-events-dlq\"})",
          "legendFormat": "DLQ total",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Active ingestion-service Members",
      "description": "How many consumer instances are currently in the ingestion-service group (design.md section 26 - consumer groups).",
      "gridPos": { "x": 18, "y": 22, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "kafka_consumergroup_members{consumergroup=\"ingestion-service\"}",
          "legendFormat": "members",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Host Resources (node-exporter / VM)",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "1 - idle time, averaged across cores. This VM has a small core count, so this is the panel to watch under load.",
      "gridPos": { "x": 0, "y": 27, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Memory Used vs Total",
      "gridPos": { "x": 12, "y": 27, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Disk Used vs Total (/)",
      "description": "Occupied vs total space on the VM's root filesystem, where Kafka/Postgres/Prometheus data volumes live.",
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_filesystem_size_bytes{mountpoint=\"/\"}",
          "legendFormat": "total",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Load Average (1m)",
      "description": "Above the VM's core count means work is queuing, not just busy.",
      "gridPos": { "x": 12, "y": 35, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_load1",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "CPU Cores",
      "gridPos": { "x": 16, "y": 35, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "count(node_cpu_seconds_total{mode=\"idle\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Disk Free (/)",
      "gridPos": { "x": 20, "y": 35, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 22,
      "type": "row",
      "title": "PostgreSQL Storage",
      "gridPos": { "x": 0, "y": 43, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 23,
      "type": "stat",
      "title": "ecommerce Database Size",
      "description": "Total on-disk size of the whole ecommerce database (all schemas: raw/staging/analytics) - the number to watch for \"how much data is Postgres storing\" specifically, as opposed to the VM's overall disk usage above.",
      "gridPos": { "x": 0, "y": 44, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT pg_database_size('ecommerce') AS bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "raw.events Table Size",
      "description": "The single fastest-growing table (one row per event, one row every ~0.5s) - includes indexes, via pg_total_relation_size.",
      "gridPos": { "x": 8, "y": 44, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT pg_total_relation_size('raw.events') AS bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "raw.events Row Count",
      "gridPos": { "x": 16, "y": 44, "w": 8, "h": 4 },
      "datasource": { "type": "postgres", "uid": "postgres-ds" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-ds" },
          "format": "table",
          "rawSql": "SELECT count(*) AS rows FROM raw.events",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    }
  ]
}
